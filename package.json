{
  "name": "langgraph-ts-agents",
  "version": "0.1.0",
  "private": false,
  "description": "TypeScript port of LangGraph supervisor/worker patterns — streaming-first, fully typed.",
  "author": "Ale Zanello <me@azanello.com>",
  "license": "MIT",
  "repository": "github:AleSZanello/langgraph-ts-agents",
  "homepage": "https://azanello.com",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "tsx src/index.ts",
